# Copier ce fichier en .env puis renseigner au minimum GROQ_API_KEY.
# Les variables laissées vides sont ignorées. Guide détaillé de la voix : docs/VOIX.md

# ---- LLM (questions de Lina et bilan) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Toute API compatible OpenAI fonctionne (Groq par défaut)
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Sur Lambda derrière API Gateway (limite 30 s), réduire à ~20000
LLM_TIMEOUT_MS=30000

# ---- Voix de Lina (synthèse vocale) ----
# piper : gratuit et local, voix du catalogue https://piperhub.org (service apps/piper)
# elevenlabs / openai : voix en ligne, payantes
# browser : voix intégrée au navigateur ; none : texte uniquement
# auto : ElevenLabs si sa clé est présente, sinon OpenAI, sinon Piper si PIPER_URL, sinon navigateur
TTS_PROVIDER=piper

# Piper : adresse du service (docker compose up -d piper), et voix par langue.
# Par défaut : Siwis (voix féminine française) et HFC Female (voix féminine anglaise).
PIPER_URL=http://localhost:5000
PIPER_VOICE_FR=fr_FR-siwis-medium
PIPER_VOICE_EN=en_US-hfc_female-medium
# Voix officielles téléchargées dans l'image Piper (séparées par un espace)
PIPER_VOICES=fr_FR-siwis-medium en_US-hfc_female-medium
# Débit : 1 = normal, 1.1 = un peu plus posé
PIPER_LENGTH_SCALE=

# ElevenLabs (TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# OpenAI ou tout service compatible (TTS_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ---- Écoute du candidat (transcription) ----
# auto : Whisper via Groq (même clé que le LLM) ; openai ; browser : dictée du navigateur
# Sans micro, le candidat répond automatiquement par écrit.
STT_PROVIDER=auto
STT_MODEL=

# ---- Stockage des sessions ----
# auto : Upstash si configuré, sinon Redis si REDIS_URL, sinon mémoire (local uniquement)
STORE=auto
REDIS_URL=redis://localhost:6379
# Redis HTTP, compatible avec toutes les plateformes (obligatoire sur Cloudflare Workers)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Sécurité ----
# Réservé aux appels serveur à serveur : le front web ne l'envoie pas
API_KEY=
# Serveur Node derrière un proxy/load balancer : nombre de proxys de confiance (0 = aucun)
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=30
# Front hébergé sur un autre domaine que l'API : https://mon-front.com (ou *)
CORS_ORIGINS=

# ---- Entretien ----
PORT=3000
# Nombre maximal de questions (le front en demande 4, 7 ou 10 selon la durée)
TOTAL_QUESTIONS=10
SESSION_TTL_SECONDS=7200

# ---- Docker (Postgres prévu pour l'historique, pas encore utilisé) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=interview
DATABASE_URL=postgres://postgres:dev@localhost:5432/interview
