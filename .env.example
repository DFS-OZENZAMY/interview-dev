# Copier ce fichier en .env puis renseigner au minimum GROQ_API_KEY.
# Les variables laissées vides sont ignorées. Guide détaillé de la voix : docs/VOIX.md

# ---- LLM (questions de Lina et bilan) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Toute API compatible OpenAI fonctionne (Groq par défaut)
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Sur Lambda derrière API Gateway (limite 30 s), réduire à ~20000
LLM_TIMEOUT_MS=30000

# ---- Voix de Lina (synthèse vocale) ----
# piper : gratuit et local, voix du catalogue https://piperhub.org (service apps/piper)
# kokoro : gratuit et local, voix française ff_siwis (Kokoro-FastAPI, profil Docker « kokoro »)
# pocket : gratuit et local, voix plus naturelles en streaming, Kyutai Pocket TTS (apps/pocket-tts, plus lourd)
# elevenlabs / openai : voix en ligne, payantes
# browser : voix intégrée au navigateur ; none : texte uniquement
# auto : ElevenLabs si sa clé est présente, sinon OpenAI, sinon Piper si PIPER_URL, sinon navigateur
#        (Pocket TTS n'est jamais choisi en auto : TTS_PROVIDER=pocket explicitement)
TTS_PROVIDER=piper

# Piper : adresse du service (docker compose up -d piper), et voix par langue.
# Par défaut : Siwis (voix féminine française) et HFC Female (voix féminine anglaise).
PIPER_URL=http://127.0.0.1:5000
PIPER_VOICE_FR=fr_FR-siwis-medium
PIPER_VOICE_EN=en_US-hfc_female-medium
# Voix officielles téléchargées dans l'image Piper (séparées par un espace)
PIPER_VOICES=fr_FR-siwis-medium en_US-hfc_female-medium
# Débit : 1 = normal, 1.1 = un peu plus posé
PIPER_LENGTH_SCALE=

# Pocket TTS (TTS_PROVIDER=pocket) : un serveur par langue.
# Lancer : docker compose --profile pocket up -d   (avec pnpm dev : adresses ci-dessous)
POCKET_TTS_URL_FR=http://127.0.0.1:8001
POCKET_TTS_URL_EN=http://127.0.0.1:8002
# Voix féminines par défaut : Estelle (français) et Alba (anglais). Autres voix : voir docs/VOIX.md
POCKET_TTS_VOICE_FR=estelle
POCKET_TTS_VOICE_EN=alba
# Facultatif, seulement pour cloner une voix (accepter les conditions sur huggingface.co/kyutai/pocket-tts)
HF_TOKEN=

# Kokoro (TTS_PROVIDER=kokoro) : docker compose --profile kokoro up -d
KOKORO_URL=http://127.0.0.1:8880
# Voix et vitesse retenues par Achraf : ff_siwis, réglage « naturel » 0.98
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_EN=af_heart
KOKORO_SPEED=0.98

# ElevenLabs (TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# OpenAI ou tout service compatible (TTS_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ---- Écoute du candidat (transcription) ----
# auto : Whisper via Groq (même clé que le LLM) ; openai ; browser : dictée du navigateur
# Sans micro, le candidat répond automatiquement par écrit.
STT_PROVIDER=auto
STT_MODEL=

# ---- Stockage des sessions ----
# auto : Upstash si configuré, sinon Redis si REDIS_URL, sinon mémoire (local uniquement)
# En local, Redis injoignable au démarrage = bascule automatique en mémoire (avec un message).
# « redis://redis:6379 » ne fonctionne qu’à l’intérieur de docker compose.
STORE=auto
REDIS_URL=redis://127.0.0.1:6379
# Redis HTTP, compatible avec toutes les plateformes (obligatoire sur Cloudflare Workers)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Sécurité ----
# Réservé aux appels serveur à serveur : le front web ne l'envoie pas
API_KEY=
# Serveur Node derrière un proxy/load balancer : nombre de proxys de confiance (0 = aucun)
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=30
# Front hébergé sur un autre domaine que l'API : https://mon-front.com (ou *)
CORS_ORIGINS=

# ---- Entretien ----
PORT=3000
# Nombre maximal de questions (le front en demande 4, 7 ou 10 selon la durée)
TOTAL_QUESTIONS=10
SESSION_TTL_SECONDS=7200

# ---- Docker ----
# Adresse de publication des ports Redis, Piper et Postgres (127.0.0.1 par défaut).
# Sous WSL avec Docker Desktop, mettez 0.0.0.0 si l'API n'arrive pas à les joindre (ETIMEDOUT).
DOCKER_BIND_ADDRESS=
# Postgres : prévu pour l'historique, pas encore utilisé
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=interview
DATABASE_URL=postgres://postgres:dev@localhost:5432/interview
