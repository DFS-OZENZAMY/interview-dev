{
  "name": "api",
  "version": "1.0.0",
  "description": "API d'entretien simulé (Hono + Groq)",
  "scripts": {
    "dev": "tsx watch src/entries/node.ts",
    "build": "esbuild --bundle --platform=node --target=node20 --format=cjs --log-level=warning src/entries/node.ts --outfile=dist/node.js",
    "start": "node dist/node.js",
    "build:lambda": "esbuild --bundle --platform=node --target=node20 --format=cjs --log-level=warning src/entries/lambda.ts --outfile=dist/lambda/index.js",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13",
    "ioredis": "^5.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "~0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.15.0"
}
